# このファイルを local.mk にコピーして、自分の環境に合わせて書き換える。
# local.mk は Git で追跡しない（.gitignore）。

# ゲームのフォルダ（WayOfTheSamurai4.exe があるところ）。スラッシュ区切りで書く
GAME_DIR := C:/Program Files (x86)/Steam/steamapps/common/Way of the Samurai 4

# cmake・ctest が PATH にないときは、場所を書く
# CMAKE := C:/path/to/cmake.exe
# CTEST := C:/path/to/ctest.exe
