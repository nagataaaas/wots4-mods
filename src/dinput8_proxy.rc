// Version information of dinput8.dll. ProductName marks it as this ModLoader for the installer.
#include <winver.h>
#include "wots4_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WOTS4_VERSION_NUMBERS
PRODUCTVERSION WOTS4_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Mod loader for Way of the Samurai 4 (dinput8.dll proxy)"
            VALUE "FileVersion", WOTS4_VERSION_STRING
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName", WOTS4_LOADER_PRODUCT_NAME
            VALUE "ProductVersion", WOTS4_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
